@page
@model IndexModel
@{
    ViewData["Title"] = "Conciliação Diária";
}

<div class="container-fluid mt-4">

    <!-- Cabeçalho -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary fw-bold">Conciliação Diária</h2>
            <p class="text-muted">Batimento de caixa e sugestões de tomada de decisão.</p>
        </div>
    </div>

        @* <div class="alert alert-warning shadow-sm mt-4" role="alert">
            <strong>⚠️ Alerta de Risco:</strong> O fornecedor 'Tech Distribuidora' tem 2 títulos de alto valor vencendo amanhã.
            <a href="#" class="alert-link">Clique aqui para ver sugestões de renegociação.</a>
        </div> *@

        <partial name="_CardsResumo" model="Model.ResumoDia" />
        <partial name="_Dashboard" />
        <partial name="_BarraFiltros" model="Model" />
        <partial name="_GridTitulos" model="Model.Titulos" />

    @section Scripts {
        <!-- 1. Importa a biblioteca do Chart.js -->
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

        <!-- 2. O C# cria as variáveis com os dados e entrega para o navegador -->
        <script>
                window.dadosDashboard = {
                    fluxo: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoFluxoSemanal)),
                    parceiros: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GraficoEntradasParceiros))
                };
        </script>

        <!-- 3. Chama o seu arquivo JavaScript separado -->
        <!-- O til (~) aponta para a pasta wwwroot do seu projeto -->
        <script src="~/js/dashboard-conciliacao.js"></script>
    }
</div>