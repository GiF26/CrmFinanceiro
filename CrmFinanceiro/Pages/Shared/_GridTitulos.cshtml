@model List<CrmFinanceiro.Data.DTOs.TitulosAcaoDTO>;

<div class="card shadow-sm mb-4 mt-4">

    <div class="card-header bg-white py-3">
        <h6 class="m-0 font-weight-bold text-primary">Títulos Pendentes de Ação</h6>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Documento</th>
                        <th>Parceiro (Cliente/Fornecedor)</th>
                        <th>Tipo</th>
                        <th class="text-center">Data Emissão</th>
                        <th class="text-center">Data Vencimento</th>
                        <th class="text-center">Data Pagamento</th>
                        <th>Valor</th>
                        <th class="text-center">Ação Rápida</th>
                    </tr>
                </thead>
                <tbody>

                    @foreach (var t in @Model)
                    {
                        <tr>
                            <td>@t.Documento </td>
                            <td>@t.Parceiro</td>
                            <td><span class="@t.flagTipo">@t.Tipo</span></td>
                            <td class="text-center">@t.DataEmissao.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@t.DataVencimento.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@t.DataPagamento?.ToString("dd/MM/yyyy")</td>
                            <td>@t.Valor.ToString("c")</td>

                            <td class="text-center">
                                @if (t.Tipo.Equals("Saída"))
                                {
                                    <button class="btn btn-sm btn-outline-success">Pagar</button>
                                    <button class="btn btn-sm btn-outline-secondary">Postergar</button>
                                }else
                                {
                                    <button class="btn btn-sm btn-outline-primary">Ver Detalhes</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>